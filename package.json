{
	"name": "newsletter-tool",
	"private": true,
	"version": "0.0.2",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
		"user:create": "node --env-file-if-exists=.env --import tsx scripts/create-user.ts",
		"user:role": "node --env-file-if-exists=.env --import tsx scripts/user-role.ts",
		"start": "node build",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@types/nodemailer": "^8.0.2",
		"@types/smtp-server": "^3.5.0",
		"smtp-server": "^3.19.18",
		"@types/mjml": "^5.0.0",
		"vitest": "^5.0.3",
		"@sveltejs/adapter-node": "^5.5.7",
		"@types/pg": "^8.23.1",
		"@inquirer/prompts": "^8.7.3",
		"embedded-postgres": "18.4.0-beta.17",
		"tsx": "^4.23.15",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"nodemailer": "^10.0.16",
		"parse5": "^8.0.0",
		"better-auth": "^1.7.7",
		"pg": "^8.23.1",
		"sharp": "^0.35.5",
		"mjml": "5.3.0"
	},
	"overrides": {
		"@sveltejs/kit": { "cookie": "^0.7.2" }
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
